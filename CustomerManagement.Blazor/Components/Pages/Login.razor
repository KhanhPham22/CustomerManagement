@page "/login"

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using CustomerManagement.Blazor.Services
@inject IHttpClientFactory HttpClientFactory
@inject AuthService AuthService
@inject NavigationManager Navigation

<h1>Login</h1>

<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Username</label>
        <InputText class="form-control"
                   @bind-Value="loginModel.Username" />
        <ValidationMessage For="() => loginModel.Username" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <InputText type="password"
                   class="form-control"
                   @bind-Value="loginModel.Password" />
        <ValidationMessage For="() => loginModel.Password" />
    </div>

    // Display the login error message when an error occurs.
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <button class="btn btn-primary" type="submit">
        Login
    </button>
</EditForm>

@code {
    // Stores the username and password entered in the form.
    private LoginModel loginModel = new();

    // Stores the error message displayed to the user.
    private string? errorMessage;

    // Handle the login process when the form is submitted.
    private async Task HandleLogin()
    {
        errorMessage = null;

        // Create the HTTP client configured to call the API.
        var http = HttpClientFactory.CreateClient("Api");

        // Send the login information to the authentication API.
        var response = await http.PostAsJsonAsync(
            "api/auth/login",
            loginModel);

        // Display an error if the login request fails.
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Invalid username or password.";
            return;
        }

        // Read the JWT token returned by the API.
        var result =
            await response.Content.ReadFromJsonAsync<LoginResponse>();

        // Display an error if the response does not contain a valid token.
        if (result == null || string.IsNullOrEmpty(result.Token))
        {
            errorMessage = "Login failed.";
            return;
        }

        // Store the JWT token for authenticated API requests.
        AuthService.SetToken(result.Token);

        // Navigate to the customer list after successful login.
        Navigation.NavigateTo("/customers");
    }

    // Defines the login form data and validation rules.
    private class LoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }

    // Represents the login response returned by the API.
    private class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
    }
}