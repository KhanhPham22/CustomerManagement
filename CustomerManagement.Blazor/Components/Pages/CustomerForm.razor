@page "/customers/new"
@page "/customers/edit/{Id:int}"

@using CustomerManagement.Blazor.Models
@using CustomerManagement.Blazor.Services
@using System.ComponentModel.DataAnnotations
@inject CustomerApiService CustomerApiService
@inject NavigationManager Navigation

<PageTitle>@(IsEditMode ? "Edit Customer" : "Add Customer")</PageTitle>

<h1>@(IsEditMode ? "Edit Customer" : "Add Customer")</h1>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    // Form for creating or updating a customer.
    <EditForm Model="customer" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Customer Code</label>
            <InputText class="form-control"
                       @bind-Value="customer.CustomerCode" />
            <ValidationMessage For="@(() => customer.CustomerCode)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <InputText class="form-control"
                       @bind-Value="customer.FullName" />
            <ValidationMessage For="@(() => customer.FullName)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control"
                       @bind-Value="customer.Email" />
            <ValidationMessage For="@(() => customer.Email)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone Number</label>
            <InputText class="form-control"
                       @bind-Value="customer.PhoneNumber" />
            <ValidationMessage For="@(() => customer.PhoneNumber)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Date of Birth</label>
            <InputDate class="form-control"
                       @bind-Value="customer.DateOfBirth" />
            <ValidationMessage For="@(() => customer.DateOfBirth)" />
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input"
                           @bind-Value="customer.IsActive" />
            <label class="form-check-label">
                Active
            </label>
        </div>

        // Display an error message if the API request fails.
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        <button type="submit" class="btn btn-primary me-2">
            @(IsEditMode ? "Update" : "Create")
        </button>

        <button type="button"
                class="btn btn-secondary"
                @onclick="Cancel">
            Cancel
        </button>
    </EditForm>
}

@code {
    // Receives the customer ID from the edit URL.
    [Parameter]
    public int? Id { get; set; }

    // Stores the customer data entered in the form.
    private CustomerRequestModel customer = new();

    private bool isLoading;

    private string? errorMessage;

    // Determines whether the page is in Add or Edit mode.
    private bool IsEditMode => Id.HasValue;

    // Load existing customer data when editing.
    protected override async Task OnInitializedAsync()
    {
        if (!IsEditMode)
        {
            return;
        }

        isLoading = true;

        var existingCustomer = await CustomerApiService.GetCustomerAsync(Id!.Value);

        // Redirect to the customer list if the customer does not exist.
        if (existingCustomer == null)
        {
            Navigation.NavigateTo("/customers");
            return;
        }

        // Fill the form with the existing customer's data.
        customer = new CustomerRequestModel
            {
                CustomerCode = existingCustomer.CustomerCode,
                FullName = existingCustomer.FullName,
                Email = existingCustomer.Email,
                PhoneNumber = existingCustomer.PhoneNumber,
                DateOfBirth = existingCustomer.DateOfBirth,
                IsActive = existingCustomer.IsActive
            };

        isLoading = false;
    }

    // Handle form submission for both creating and updating customers.
    private async Task HandleSubmit()
    {
        errorMessage = null;

        try
        {
            // Update the existing customer in Edit mode.
            if (IsEditMode)
            {
                await CustomerApiService.UpdateCustomerAsync(Id!.Value, customer);
            }
            // Create a new customer in Add mode.
            else
            {
                await CustomerApiService.CreateCustomerAsync(customer);
            }

            // Return to the customer list after a successful operation.
            Navigation.NavigateTo("/customers");
        }
        catch (Exception ex)
        {
            // Display the error returned from the API.
            errorMessage = ex.Message;
        }
    }

    // Cancel the operation and return to the customer list.
    private void Cancel()
    {
        Navigation.NavigateTo("/customers");
    }

    // Defines the form model and its validation rules.
    private class CustomerRequestModel
    {
        [Required]
        [MaxLength(20)]
        public string CustomerCode { get; set; } = string.Empty;

        [Required]
        [MaxLength(100)]
        public string FullName { get; set; } = string.Empty;

        [EmailAddress]
        [MaxLength(150)]
        public string? Email { get; set; }

        [Required]
        [MaxLength(20)]
        public string PhoneNumber { get; set; } = string.Empty;

        public DateTime? DateOfBirth { get; set; }

        public bool IsActive { get; set; } = true;
    }
}