@page "/customers"

@using CustomerManagement.Blazor.Models
@using CustomerManagement.Blazor.Services
@inject CustomerApiService CustomerApiService
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Customers</PageTitle>

<h1>Customers</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2">
        <input class="form-control"
               placeholder="Search by name or phone..."
               value="@searchText"
               @oninput="HandleSearchInput" />

        <button class="btn btn-primary" @onclick="Search">
            Search
        </button>
    </div>

    <button class="btn btn-success" @onclick="AddCustomer">
        Add Customer
    </button>
</div>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (customers.Count == 0)
{
    <p>No customers found.</p>
}
else
{
    // Display customers in a table.
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Date of Birth</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                // Display customers for the current page.
                @foreach (var customer in PagedCustomers)
                {
                    <tr>
                        <td>@customer.CustomerCode</td>
                        <td>@customer.FullName</td>
                        <td>@customer.Email</td>
                        <td>@customer.PhoneNumber</td>
                        <td>@customer.DateOfBirth?.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (customer.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1"
                                    @onclick="() => EditCustomer(customer.Id)">
                                Edit
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => DeleteCustomer(customer.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    // Display pagination controls when there is more than one page.
    @if (TotalPages > 1)
    {
        <div class="d-flex justify-content-center align-items-center gap-2 mt-3">

            <button class="btn btn-outline-secondary"
                    disabled="@(currentPage == 1)"
                    @onclick="PreviousPage">
                Previous
            </button>

            @for (int page = 1; page <= TotalPages; page++)
            {
                var pageNumber = page;

                <button class="btn @(currentPage == pageNumber ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => GoToPage(pageNumber)">
                    @pageNumber
                </button>
            }

            <button class="btn btn-outline-secondary"
                    disabled="@(currentPage == TotalPages)"
                    @onclick="NextPage">
                Next
            </button>

        </div>
    }
}

@code {
    // Stores the customers loaded from the API.
    private List<CustomerDto> customers = new();

    private string searchText = string.Empty;

    private bool isLoading = true;

    // Tracks the current page.
    private int currentPage = 1;

    // Number of customers displayed per page.
    private const int pageSize = 10;

    // Calculate the total number of pages.
    private int TotalPages =>
        (int)Math.Ceiling(customers.Count / (double)pageSize);

    // Get only the customers for the current page.
    private IEnumerable<CustomerDto> PagedCustomers =>
        customers
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);

    // Check authentication and load customers when the page starts.
    protected override async Task OnInitializedAsync()
    {
        // Must login before accessing customers.
        if (!AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadCustomers();
    }

    // Update the search text when the user types.
    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;

        // Reload all customers when the search box is cleared.
        if (string.IsNullOrWhiteSpace(searchText))
        {
            await LoadCustomers();
        }
    }

    // Load customers from the API and reset to the first page.
    private async Task LoadCustomers()
    {
        isLoading = true;

        customers = await CustomerApiService.GetCustomersAsync(searchText);

        currentPage = 1;

        isLoading = false;
    }

    // Search customers using the current search text.
    private async Task Search()
    {
        await LoadCustomers();
    }

    // Navigate to the Add Customer page.
    private void AddCustomer()
    {
        Navigation.NavigateTo("/customers/new");
    }

    // Navigate to the Edit Customer page.
    private void EditCustomer(int id)
    {
        Navigation.NavigateTo($"/customers/edit/{id}");
    }

    // Delete a customer and reload the customer list.
    private async Task DeleteCustomer(int id)
    {
        await CustomerApiService.DeleteCustomerAsync(id);

        await LoadCustomers();
    }

    // Go to a specific page.
    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            currentPage = page;
        }
    }

    // Move to the previous page.
    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    // Move to the next page.
    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }
}