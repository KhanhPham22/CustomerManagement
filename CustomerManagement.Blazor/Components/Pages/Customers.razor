@page "/customers"

@using CustomerManagement.Blazor.Models
@using CustomerManagement.Blazor.Services
@inject CustomerApiService CustomerApiService
@inject NavigationManager Navigation

<PageTitle>Customers</PageTitle>

<h1>Customers</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2">
        <input class="form-control"
               placeholder="Search by name or phone..."
               @bind="searchText" />

        <button class="btn btn-primary" @onclick="Search">
            Search
        </button>
    </div>

    <button class="btn btn-success" @onclick="AddCustomer">
        Add Customer
    </button>
</div>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (customers.Count == 0)
{
    <p>No customers found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Date of Birth</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var customer in PagedCustomers)
                {
                    <tr>
                        <td>@customer.CustomerCode</td>
                        <td>@customer.FullName</td>
                        <td>@customer.Email</td>
                        <td>@customer.PhoneNumber</td>
                        <td>@customer.DateOfBirth?.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (customer.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1"
                                    @onclick="() => EditCustomer(customer.Id)">
                                Edit
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => DeleteCustomer(customer.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (TotalPages > 1)
    {
        <div class="d-flex justify-content-center align-items-center gap-2 mt-3">

            <button class="btn btn-outline-secondary"
                    disabled="@(currentPage == 1)"
                    @onclick="PreviousPage">
                Previous
            </button>

            @for (int page = 1; page <= TotalPages; page++)
            {
                var pageNumber = page;

                <button class="btn @(currentPage == pageNumber ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => GoToPage(pageNumber)">
                    @pageNumber
                </button>
            }

            <button class="btn btn-outline-secondary"
                    disabled="@(currentPage == TotalPages)"
                    @onclick="NextPage">
                Next
            </button>

        </div>
    }
}

@code {
    private List<CustomerDto> customers = new();

    private string searchText = string.Empty;

    private bool isLoading = true;

    private int currentPage = 1;

    // Display 10 customers per page.
    private const int pageSize = 10;

    // Calculate the total number of pages.
    private int TotalPages =>
        (int)Math.Ceiling(customers.Count / (double)pageSize);

    // Show only customers belonging to the current page.
    private IEnumerable<CustomerDto> PagedCustomers =>
        customers
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        isLoading = true;

        // Load customers from the Web API.
        customers = await CustomerApiService.GetCustomersAsync(searchText);

        // Return to the first page after reloading data.
        currentPage = 1;

        isLoading = false;
    }

    private async Task Search()
    {
        await LoadCustomers();
    }

    private void AddCustomer()
    {
        Navigation.NavigateTo("/customers/new");
    }

    private void EditCustomer(int id)
    {
        Navigation.NavigateTo($"/customers/edit/{id}");
    }

    private async Task DeleteCustomer(int id)
    {
        await CustomerApiService.DeleteCustomerAsync(id);

        // Reload the list after deletion.
        await LoadCustomers();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            currentPage = page;
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }
}